# Copy this file to .env.local only for local development; never commit real values.
# The VITE_ values are public and may be included in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private values: configure only in the server/Vercel environment, without VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
