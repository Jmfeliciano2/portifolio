# ========================================
# PORTFÓLIO - CONFIGURAÇÃO DE AMBIENTE
# ========================================

# Porta do servidor Express (opcional, padrão 3000)
PORT=3000

# E-mail administrativo para login no painel
ADMIN_EMAIL=admin@example.com

# Hash bcrypt da senha administrativa (gerar com: node Backend/scripts/gerar-hash.js "sua_senha")
ADMIN_PASSWORD_HASH=cole_o_hash_bcrypt_aqui

# Chave secreta para assinatura dos tokens JWT (utilize uma string longa e aleatória)
JWT_SECRET=gere_um_segredo_forte_aqui

# Caminho opcional para o banco de dados (padrão: Backend/database.sqlite)
# DATABASE_PATH=Backend/database.sqlite
